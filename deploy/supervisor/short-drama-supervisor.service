[Unit]
Description=Short drama Supervisor
After=network.target

[Service]
Type=forking
RuntimeDirectory=short-drama-supervisor
RuntimeDirectoryMode=0700
LogsDirectory=short-drama
PIDFile=/run/short-drama-supervisor/supervisord.pid
ExecStart=/usr/bin/supervisord -c /etc/short-drama/supervisord.conf
ExecStop=/usr/bin/supervisorctl -c /etc/short-drama/supervisord.conf shutdown
Restart=on-failure
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
