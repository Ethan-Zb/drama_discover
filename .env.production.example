# Select the environment in the PROCESS: APP_ENV=production
# Copy to .env.production; replace credentials and secret before use.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-32-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
CMS_LOCAL_HOSTS=127.0.0.1,localhost
DB_NAME=short_drama_prod
DB_USER=shortdrama
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Use 0 only for initial HTTP verification. Enable 1 after HTTPS is configured.
DJANGO_HTTPS=1
DJANGO_HSTS_SECONDS=0
